# ---------------------------------------------------------------------------
# Configuracion del bot de relevamiento de visitas - FACBSA
# Copiar este archivo como .env y completar los valores.
# ---------------------------------------------------------------------------

# Puerto donde escucha el servidor
PORT=3000

# Ruta del archivo de base de datos SQLite
DB_PATH=./datos/facbsa.db

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Se obtienen en developers.facebook.com > tu app > WhatsApp > Configuracion API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Este valor lo inventas vos y lo pegas igual en el panel de Meta al dar de alta el webhook
WHATSAPP_VERIFY_TOKEN=facbsa-verificacion
# App Secret de la app de Meta: se usa para validar la firma de cada webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Simulador ---------------------------------------------------------------
# true = habilita /simulador para probar el chat sin cuenta de WhatsApp
SIMULADOR=true

# --- Panel de seguimiento ----------------------------------------------------
# Clave para acceder a /panel y a la exportacion. Vacio = panel deshabilitado.
ADMIN_KEY=
