# ---------------------------------------------------------------------------
# Configuracion del bot de relevamiento de visitas - FACBSA
# Copiar este archivo como .env y completar los valores.
# ---------------------------------------------------------------------------

PORT=3000
DB_PATH=./datos/facbsa.db

# --- Agente conversacional (Claude) -----------------------------------------
# Con clave: el vendedor habla como habla y el agente entiende, registra y
# repregunta lo que falta.
# Sin clave: el bot sigue funcionando en "modo guiado", preguntando de a una.
# Se saca en console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Con 'low' contesta rapido y sale barato;
# subilo si lo ves flojo entendiendo audios largos.
ANTHROPIC_EFFORT=low

# --- Transcripcion de las notas de voz --------------------------------------
# Claude no procesa audio: la transcripcion la hace un servicio aparte.
# openai | deepgram | ninguno
TRANSCRIPCION_PROVEEDOR=ninguno
TRANSCRIPCION_API_KEY=
# openai: whisper-1 (por defecto) | gpt-4o-transcribe
# deepgram: nova-3 (por defecto)
TRANSCRIPCION_MODELO=

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Se obtienen en developers.facebook.com > tu app > WhatsApp > Configuracion API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Este valor lo inventas vos y lo pegas igual en el panel de Meta al dar de alta el webhook
WHATSAPP_VERIFY_TOKEN=facbsa-verificacion
# App Secret de la app de Meta: se usa para validar la firma de cada webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Simulador ---------------------------------------------------------------
# true = habilita /simulador para probar el chat sin cuenta de WhatsApp
SIMULADOR=true

# --- Panel de seguimiento ----------------------------------------------------
# Clave para acceder a /panel y a la exportacion. Vacio = panel deshabilitado.
ADMIN_KEY=
